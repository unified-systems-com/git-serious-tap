        {
          "entity": {
            "entity_id": "01a090e4-1717-7090-8d34-1fd3684bc299",
            "entity_type": "search",
            "name": "git-serious — what every read workflow names, and cannot find",
            "dimensions": {
              "tap.graph": "web"
            }
          },
          "node": {
            "name": "git-serious — what every read workflow names, and cannot find",
            "description": "One row per workflow whose body was read (tags.secret_refs IS NOT NULL): repository, file, the secrets.X names it uses, the ones no readable scope defines, the scopes read. Projection mode (rows, not nodes — tap#432); ORDER BY missing DESC puts the workflows that cannot find a name first. Estate-wide; the tap page's copy pins a repository instead.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (w:github_core__github_workflow)",
                "WHERE w.data.tags.secret_refs.scopes_read IS NOT NULL",
                "RETURN w.data.full_name AS repository, w.data.path AS workflow, w.data.tags.secret_refs.referenced AS named, w.data.tags.secret_refs.unresolved AS missing, w.data.tags.secret_refs.scopes_read AS scopes_read, w.data.workflow_id AS workflow_id",
                "ORDER BY missing DESC"
              ]
            },
            "input_schema": {
              "type": "object",
              "properties": {}
            },
            "max_limit": 1000
          }
        },
        {
          "entity": {
            "entity_id": "01a090e4-1717-7090-8d34-1fd47b59a15a",
            "entity_type": "panel",
            "name": "What every workflow names",
            "dimensions": {
              "tap.graph": "web"
            }
          },
          "node": {
            "slug": "git-serious-secrets-named",
            "name": "What every workflow names",
            "view": "tap_web/panels/table_panel.html",
            "editor_view": "",
            "description": "Every read workflow across the estate: the secrets.X names it uses, the ones no readable scope defines, and the scopes that were read. Row click opens the workflow's annotated file when zizmor is installed.",
            "config": {
              "hide_header": false,
              "height": 480,
              "quick_filter": true,
              "default_page_size": 100,
              "row_url_template": "/zizmor/workflow?workflow_id={workflow_id}",
              "columns": [
                {
                  "field": "repository",
                  "title": "Repository",
                  "width": 200,
                  "headerSort": true,
                  "formatter": "tailSegment"
                },
                {
                  "field": "workflow",
                  "title": "Workflow",
                  "widthGrow": 2,
                  "headerSort": true
                },
                {
                  "field": "named",
                  "title": "Names",
                  "widthGrow": 2,
                  "headerSort": true,
                  "header_tooltip": "Every secrets.X the file names inside an expression; GITHUB_TOKEN is the built-in and is not counted."
                },
                {
                  "field": "missing",
                  "title": "Cannot find",
                  "widthGrow": 2,
                  "headerSort": true,
                  "header_tooltip": "Names no readable scope defines. At runtime the step receives an empty string and the job runs anyway."
                },
                {
                  "field": "scopes_read",
                  "title": "Scopes read",
                  "width": 220,
                  "header_tooltip": "'Cannot find' is only ever a claim about these."
                }
              ]
            }
          }
        }
