      "batch_node": {
        "source": "plugins.git_serious.grift.landing",
        "name": "git-serious landing v0.1.0",
        "description": "First light (git-serious-tap#17): the observed account's CI/CD system as one graph — platform → account → repositories → workflows, plus the GitHub Apps enabled on them, runners, and the Actions OIDC issuer. A Gryphon seed search per label (github_core carries no tag dimension a bare scan could key on), an ORM all-edges search the graph panel filters to the matched node-set, and a minimal projection (one elevation, one arrangements-only layout → default cose placement). GitHub nodes single-tap to their html_url. Runs and jobs are deliberately OFF the landing graph — 10 runs × N repos is noise at this altitude; they belong to drill-down pages."
      },
      "nodes": [
        {
          "entity": {
            "entity_id": "01a03f78-11fa-7029-823d-7944e18dd24a",
            "entity_type": "search",
            "name": "git-serious — CI/CD system nodes",
            "dimensions": {}
          },
          "node": {
            "name": "git-serious — CI/CD system nodes",
            "description": "Gryphon: every github_core node type that belongs on the account-level picture (platform, account, repository, workflow, app, runner) plus the identity_core OIDC issuer github mints. Explicit per-label MATCHes: github_core carries no tag dimension, so there is nothing for a bare MATCH (n) to key on.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (n0:github_core__github_platform)",
                "MATCH (n1:github_core__github_account)",
                "MATCH (n2:github_core__github_repository)",
                "MATCH (n3:github_core__github_workflow)",
                "MATCH (n4:github_core__github_app)",
