          "node": {
            "name": "git-serious — failed runs per workflow (count)",
            "description": "Status-badge population (rows of entity_id + count): for each workflow, how many of the runs github_core collected concluded `failure`. Counts the collected window, not all of history; a workflow with no row has no failed run in that window — which is not the same as no run at all (see the no-run-observed search).",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (r:github_core__github_actions_run)-[e:EXECUTES_WORKFLOW__github_core]->(w:github_core__github_workflow)",
                "WHERE r.data.conclusion = \"failure\"",
                "RETURN w.entity_id AS entity_id, COUNT(r.entity_id) AS count"
              ]
            }
          }
        },
