          "node": {
            "name": "git-serious — machinery scene nodes (one repository)",
            "description": "Gryphon, one global WHERE scoped per variable: github.com + the account (unfiltered, one each), and the selected repository's row, workflows, declared jobs and refs by `full_name = $repo`; environments, rulesets and apps unfiltered because their attachment is an edge (HAS_ENVIRONMENT, PROTECTS, ENABLED_ON) and the layout module hides any no repository in the scene owns. `$repo` comes from the page URL (?repo=owner/name) and defaults to the primary repository (input_schema default; req-grid-search-obj-5-2) until the boot profile names it (git-serious-tap#18).",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (p:github_core__github_platform)",
                "MATCH (a:github_core__github_account)",
                "MATCH (r:github_core__github_repository)",
                "MATCH (w:github_core__github_workflow)",
                "MATCH (j:github_core__workflow_job)",
                "MATCH (g:github_core__git_ref)",
                "MATCH (e:github_core__github_environment)",
                "MATCH (rs:github_core__github_ruleset)",
                "MATCH (ap:github_core__github_app)",
                "WHERE r.data.full_name = $repo AND w.data.full_name = $repo AND j.data.full_name = $repo AND g.data.full_name = $repo"
              ]
            },
            "input_schema": {
              "type": "object",
              "properties": {
                "repo": {
                  "type": "string",
                  "default": "unified-systems-com/tap",
                  "description": "The repository's full_name (owner/name). Defaults to the instance's primary repository until the boot profile names it (git-serious-tap#18)."
