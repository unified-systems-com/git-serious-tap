    {
      "batch_entity": {
        "entity_id": "01a067e1-8266-71e1-bb86-fba986971fac",
        "entity_type": "batch",
        "name": "git-serious gate view v0.1.1",
        "dimensions": {}
      },
      "batch_node": {
        "source": "plugins.git_serious.grift.gate",
        "name": "git-serious gate view v0.1.1",
        "description": "The gate (git-serious-tap#6): for a repository's default branch, what must be true for a commit to land — and what we cannot see. Four Gryphon-backed table panels over the self-tier vocabulary: the rulesets and what they enforce, the bypass lists a read-only credential cannot read, the declared jobs that check out a ref they were handed, and the cache entries written from outside an observed ref. Two of the four are ABSENCE panels by design — an empty bypass column and a missing ref edge each mean something specific, and rendering either as nothing would be the most reassuring possible lie. Tables rather than a graph at this altitude: the landing page carries the picture, this page carries the adjudication. v0.1.1 (git-serious-tap#47): the per-repository gates table at the top — the four per-ruleset panels below it are the parts; this is the posture."
      },
      "nodes": [
        {
          "entity": {
            "entity_id": "01a067e1-8266-71e1-bb86-fba70412f6ec",
            "entity_type": "panel",
            "name": "Each repository's gate",
            "dimensions": {
              "tap.graph": "web"
            }
          },
          "node": {
            "name": "Each repository's gate",
            "slug": "git-serious-gate-gates",
            "description": "What gates each repository's default branch, and what we cannot see. One row per repository: the rulesets governing its default branch, whether a pull request is required, each required check and what produces it — a workflow in this repository, an installed App, or nothing observed (the branch cannot merge) — the bypass list in three states (not observable / counted / observed), and the checks its peers require that it does not. Derived by github_core's github-gates panel from the PROTECTS, REQUIRES_CHECK, PRODUCES_CHECK and DEFINES_WORKFLOW edges; worst gate first. Serves req-git-serious-branch-protection-tiers-1, req-git-serious-configured-the-same-1 and the gate chain of req-git-serious-why-not-merging (git-serious-tap#47).",
            "view": "github_core/panels/gates.html",
            "config": {
              "quick_filter": true,
              "height": 480,
              "refresh_seconds": 300
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a04571-e211-731b-8db7-646d661f90d7",
            "entity_type": "search",
            "name": "git-serious — the gate on each ref",
            "dimensions": {}
          },
          "node": {
            "name": "git-serious — the gate on each ref",
            "description": "Every ruleset on the account, with what it enforces and whether its bypass list could be read at all. One node per ruleset however many repositories it protects — an organization ruleset is a single object, and the repositories it covers are the PROTECTS edges.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (rs:github_core__github_ruleset)"
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a04571-e211-731b-8db7-646ea22c5b90",
            "entity_type": "search",
            "name": "git-serious — bypass lists we could not read",
            "dimensions": {}
          },
          "node": {
            "name": "git-serious — bypass lists we could not read",
            "description": "Rulesets whose bypass-actor list this credential cannot see. GitHub returns it only to a caller with WRITE access to the ruleset, which a read-only observer deliberately does not have. These rows are the reason the gate page does not render an empty bypass column as 'nobody can bypass'.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (rs:github_core__github_ruleset) WHERE rs.data.bypass_observability = \"unobservable\""
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a04571-e211-731b-8db7-646f046034fe",
            "entity_type": "search",
            "name": "git-serious — jobs that check out a caller-supplied ref",
            "dimensions": {}
          },
          "node": {
            "name": "git-serious — jobs that check out a caller-supplied ref",
            "description": "Declared jobs that pass an explicit `ref:` to actions/checkout. Read together with the job's trigger: a `pull_request_target` workflow checking out the pull request's head runs a contributor's code with the base repository's secrets — the most-cited shape in the incident corpus.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (j:github_core__workflow_job) WHERE j.data.checkout_ref != \"\""
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a04571-e211-731b-8db7-6470ca703f39",
            "entity_type": "search",
            "name": "git-serious — cache entries from outside an observed ref",
            "dimensions": {}
          },
          "node": {
            "name": "git-serious — cache entries from outside an observed ref",
            "description": "Stored cache entries with no SCOPED_TO edge, which in practice means the entry was written from a pull-request ref. A cache written outside a branch and restored inside it is the shape five documented compromises share. The NOT EXISTS anti-join needs an edge in the main pattern, hence the HAS_CACHE hop.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (repo:github_core__github_repository)-[e:HAS_CACHE__github_core]->(c:github_core__actions_cache)",
                "NOT EXISTS { MATCH (c)-[:SCOPED_TO__github_core]->(r:github_core__git_ref) }"
              ]
            }
          }
        },
