        "name": "git-serious org view v0.1.0",
        "dimensions": {}
      },
      "batch_node": {
        "source": "plugins.git_serious.grift.org",
        "name": "git-serious org view v0.1.0",
        "description": "The organization-level view, split out of the landing bundle 2026-09-02 so the landing can be refactored toward the TAP machinery while this picture keeps evolving on its own: the observed account's CI/CD system as containment — account ⊃ repositories ⊃ workflows — with the platform above and the GitHub Apps + Actions OIDC issuer below, and the status wall riding the workflow cards as badges (red = failed runs in the collected window, grey = no run observed). A full copy of landing v0.2.0 with fresh ids and its own layout module (static/git_serious/js/projections/org.js): no entity is shared with the landing bundle, so the two pages diverge without coupling."
      },
      "nodes": [
        {
          "entity": {
            "entity_id": "01a06316-280e-7762-8a41-3f71b704f0f5",
            "entity_type": "search",
            "name": "git-serious org — CI/CD system nodes",
            "dimensions": {}
          },
          "node": {
            "name": "git-serious org — CI/CD system nodes",
            "description": "Gryphon: every github_core node type that belongs on the account-level picture (platform, account, repository, workflow, app, runner) plus the identity_core OIDC issuer github mints. Explicit per-label MATCHes: github_core carries no tag dimension, so there is nothing for a bare MATCH (n) to key on.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (n0:github_core__github_platform)",
                "MATCH (n1:github_core__github_account)",
                "MATCH (n2:github_core__github_repository)",
                "MATCH (n3:github_core__github_workflow)",
                "MATCH (n4:github_core__github_app)",
                "MATCH (n5:github_core__github_runner)",
                "MATCH (oi:identity_core__oidc_issuer)"
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a06316-280e-7762-8a41-3f724177e48b",
            "entity_type": "search",
            "name": "git-serious org — all edges (graph_panel filters by node-set)",
            "dimensions": {}
          },
          "node": {
            "name": "git-serious org — all edges (graph_panel filters by node-set)",
            "description": "All edges; the graph panel keeps only those whose endpoints are in the matched node-set (tap_viz panel-graph.js).",
            "search_type": "orm",
            "root": "edge",
            "definition": {
              "filters": {},
              "order_by": [
                "edge_type"
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a06316-280e-7762-8a41-3f7308146e59",
            "entity_type": "search",
            "name": "git-serious org — failed runs per workflow (count)",
            "dimensions": {}
          },
          "node": {
            "name": "git-serious org — failed runs per workflow (count)",
            "description": "Status-badge population (rows of entity_id + count): for each workflow, how many of the runs github_core collected concluded `failure`. Counts the collected window, not all of history; a workflow with no row has no failed run in that window — which is not the same as no run at all (see the no-run-observed search).",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (r:github_core__github_actions_run)-[e:EXECUTES_WORKFLOW__github_core]->(w:github_core__github_workflow)",
                "WHERE r.data.conclusion = \"failure\"",
                "RETURN w.entity_id AS entity_id, COUNT(r.entity_id) AS count"
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a06316-280e-7762-8a41-3f745cde8cdc",
            "entity_type": "search",
            "name": "git-serious org — failed runs per workflow (detail)",
            "dimensions": {}
          },
          "node": {
            "name": "git-serious org — failed runs per workflow (detail)",
            "description": "Info-window rows (entity_id + name) for the failed-runs badge: the branch each failed run was on, so the window reads as *which branch is red*, not a run number.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (r:github_core__github_actions_run)-[e:EXECUTES_WORKFLOW__github_core]->(w:github_core__github_workflow)",
                "WHERE r.data.conclusion = \"failure\"",
                "RETURN w.entity_id AS entity_id, r.data.head_branch AS name"
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a06316-280e-7762-8a41-3f75f95a9ea8",
            "entity_type": "search",
            "name": "git-serious org — workflows with no run observed (count)",
            "dimensions": {}
          },
          "node": {
            "name": "git-serious org — workflows with no run observed (count)",
            "description": "Status-badge population for the third state: workflows github_core collected NO run for. Absence of a run edge is the signal; rendering these as plain green cards would report 'passing' on no evidence (presence is not correctness). The NOT EXISTS anti-join hangs off DEFINES_WORKFLOW because Gryphon needs an edge in the main pattern.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (repo:github_core__github_repository)-[e:DEFINES_WORKFLOW__github_core]->(w:github_core__github_workflow)",
                "NOT EXISTS { MATCH (r:github_core__github_actions_run)-[:EXECUTES_WORKFLOW__github_core]->(w) }",
                "RETURN w.entity_id AS entity_id, COUNT(w.entity_id) AS count"
              ]
            }
          }
        },
        {
          "entity": {
            "entity_id": "01a06316-280e-7762-8a41-3f7659ac952a",
            "entity_type": "search",
            "name": "git-serious org — workflows with no run observed (detail)",
            "dimensions": {}
          },
          "node": {
            "name": "git-serious org — workflows with no run observed (detail)",
            "description": "Info-window rows for the no-run-observed badge: the workflow file path, so the window names what was not observed.",
            "search_type": "gryphon",
            "root": "node",
            "definition": {
              "query": [
                "MATCH (repo:github_core__github_repository)-[e:DEFINES_WORKFLOW__github_core]->(w:github_core__github_workflow)",
                "NOT EXISTS { MATCH (r:github_core__github_actions_run)-[:EXECUTES_WORKFLOW__github_core]->(w) }",
                "RETURN w.entity_id AS entity_id, w.data.path AS name"
              ]
            }
          }
        },
        {
